   "lines": [
    {
     "id": "H1",
     "text": "Picture a county where 612 residents were referred for help.",
     "start": 0.3,
     "end": 4.608
    },
    {
     "id": "H2",
     "text": "256 of them never got there.",
     "start": 5.008,
     "end": 7.651
